<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002" author="neto-student">

        <createTable tableName="stored_files" remarks="Файлы пользователей в облачном хранилище">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints
                        nullable="false"
                        foreignKeyName="fk_files_user"
                        referencedTableName="users"
                        referencedColumnNames="id"
                        deleteCascade="true"/>
            </column>
            <column name="filename" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="storage_filename" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_files_storage_name"/>
            </column>
            <column name="size" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="file_hash" type="VARCHAR(64)"/>

            <column name="uploaded_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addComments tableName="stored_files">
            <comment>Метаданные файлов: имя, размер, владелец, дата загрузки. Сами файлы хранятся на диске.</comment>
        </addComments>

        <rollback>
            <dropTable tableName="stored_files" cascadeConstraints="true"/>
        </rollback>

    </changeSet>

</databaseChangeLog>